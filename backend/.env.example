# Copy to backend/.env for local (non-docker) development.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://undeclared:undeclared@localhost:5432/undeclared
REDIS_URL=redis://localhost:6379/0
# true = run background tasks inline (no Redis/worker needed)
CELERY_EAGER=true
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ENFORCE_MFA=false
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_PATH=./var/storage
# S3_BUCKET=undeclared-documents
# S3_ENDPOINT_URL=              # set for MinIO / other S3-compatible stores
AI_PROVIDER=simulated          # simulated | anthropic
# ANTHROPIC_API_KEY=
# AI_PHI_ALLOWED=false          # only true with a signed BAA and approved data flow
RATE_LIMIT_AUTH_PER_MINUTE=20
