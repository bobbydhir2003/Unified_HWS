# Copy to backend/.env for local (non-docker) development.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://undeclared:undeclared@localhost:5432/undeclared
REDIS_URL=redis://localhost:6379/0
# true = run background tasks inline (no Redis/worker needed)
CELERY_EAGER=true
ENGINE_INPROCESS_SCHEDULER=true  # dev only: run outbox dispatcher, escalations and monitors in the API process
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ENFORCE_MFA=false
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_PATH=./var/storage
# S3_BUCKET=undeclared-documents
# S3_ENDPOINT_URL=              # set for MinIO / other S3-compatible stores
AI_PROVIDER=simulated          # simulated | anthropic
# ANTHROPIC_API_KEY=
# AI_PHI_ALLOWED=false          # only true with a signed BAA and approved data flow
RATE_LIMIT_AUTH_PER_MINUTE=20

# --- AI provider (backend only; never put keys in frontend env) ---
# AI_PROVIDER=simulated | anthropic | openai
# OPENAI_API_KEY=
# AI_TEXT_MODEL=            # required for openai; a model your account offers that supports structured outputs + tools
# AI_VISION_MODEL=          # image/PDF document intelligence (defaults to AI_TEXT_MODEL)
# AI_TRANSCRIPTION_MODEL=   # scribe audio transcription
# AI_PRICES={"model-prefix":[usd_per_M_input,usd_per_M_output]}   # optional, enables cost tracking
# AI_PHI_ALLOWED=false      # keep false unless a BAA + data-flow review covers the provider

# Fernet key for stored secrets (AI provider keys). Required in production. Generate:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIALS_ENCRYPTION_KEY=
